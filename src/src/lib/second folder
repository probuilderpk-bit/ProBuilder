interface Enrollment {
  id: string;
  progress: number;
  enrolled_at: string;
  courses: {
    id: string;
    title: string;
    description: string | null;
  } | null;
}

export default function Dashboard() {
  const { user, signOut } = useAuth();
  const [profile, setProfile] = useState<Profile | null>(null);
  const [enrollments, setEnrollments] = useState<Enrollment[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (!user) return;

    async function loadDashboardData() {
      setLoading(true);

      const [{ data: profileData }, { data: enrollmentData }] = await Promise.all([
        supabase.from('profiles').select('*').eq('id', user.id).single(),
        supabase
          .from('enrollments')
          .select('id, progress, enrolled_at, courses(id, title, description)')
          .eq('user_id', user.id),
      ]);

      setProfile(profileData as Profile | null);
      setEnrollments((enrollmentData as unknown as Enrollment[]) ?? []);
      setLoading(false);
    }

    loadDashboardData();
  }, [user]);

  if (!user) {
    return <p>Please log in to view your dashboard.</p>;
  }

  if (loading) {
    return <p>Loading your dashboard…</p>;
  }

  return (
    <div>
      <header>
        <h1>Welcome{profile?.full_name ? `, ${profile.full_name}` : ''}</h1>
        <p>{profile?.email ?? user.email}</p>
        <button onClick={() => signOut()}>Log out</button>
      </header>

      <section>
        <h2>Your courses</h2>
        {enrollments.length === 0 ? (
          <p>You haven't enrolled in any courses yet.</p>
        ) : (
          <ul>
            {enrollments.map((enrollment) => (
              <li key={enrollment.id}>
                <strong>{enrollment.courses?.title ?? 'Untitled course'}</strong>
                <p>{enrollment.courses?.description}</p>
                <p>Progress: {enrollment.progress}%</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  );
}
